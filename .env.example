# Telegram bot settings for @ginekolog_maslahati_bot.
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
ADMIN_CHAT_ID="YOUR_ADMIN_TELEGRAM_CHAT_ID"

# The website is a static Netlify-friendly link-in-bio page.
# Public profile links are configured in app-config.js, not in .env.
#
# Why: Telegram/Instagram links are visible to every visitor anyway, and
# static hosts like Netlify cannot hide frontend-only values in .env files.
#
# Edit app-config.js when you are ready to set:
# - Telegram bot link
# - Telegram channel link
# - Instagram link
# - footer social links
