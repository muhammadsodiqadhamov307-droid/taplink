# Telegram Mini App / Bot settings.
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
ADMIN_TELEGRAM_ID="YOUR_ADMIN_TELEGRAM_USER_ID"

# Public HTTPS URL where backend/server.js is hosted.
# For local Telegram testing, use an HTTPS tunnel such as ngrok.
BASE_URL="https://yourdomain.com"

# Local SQLite database path.
DATABASE_URL="sqlite://backend/chat.db"

# Shared secret used by the bot to notify the backend about new bot messages.
INTERNAL_API_TOKEN="CHANGE_ME_TO_A_RANDOM_SECRET"
INTERNAL_API_BASE_URL="http://localhost:3000"

# Express server port.
PORT=3000

# Optional local browser fallback outside Telegram, never use in production.
# NODE_ENV=development
# DEV_TELEGRAM_ID="YOUR_TEST_TELEGRAM_ID"
# DEV_FIRST_NAME="Dev User"
